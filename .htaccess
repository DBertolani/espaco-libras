# ============================================================
# LIGHTHOUSE OPTIMIZATION - CACHE HEADERS & COMPRESSION
# ============================================================

# Ativar compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache Headers para diferentes tipos de arquivo
<IfModule mod_expires.c>
  ExpiresActive On

  # Cache padrão: 1 ano (assets estáticos)
  ExpiresDefault "access plus 1 year"

  # HTML: 1 hora (mudanças rápidas)
  ExpiresByType text/html "access plus 1 hour"

  # CSS: 1 mês
  ExpiresByType text/css "access plus 1 month"

  # JavaScript: 1 mês
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Imagens: 1 ano
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts: 1 ano
  ExpiresByType application/x-font-ttf "access plus 1 year"
  ExpiresByType font/opentype "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType application/x-font-woff "access plus 1 year"
  ExpiresByType application/x-font-woff2 "access plus 1 year"

  # Manifesto & Feed: 24 horas
  ExpiresByType application/x-web-app-manifest+json "access plus 24 hours"
  ExpiresByType application/rss+xml "access plus 24 hours"
  ExpiresByType application/atom+xml "access plus 24 hours"
</IfModule>

# Cache Control Headers
<IfModule mod_headers.c>
  # HTML - Sem cache (validação com ETag)
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>

  # CSS & JS - Cache agressivo
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagens - Cache agressivo
  <FilesMatch "\.(jpg|jpeg|gif|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Fonts - Cache agressivo
  <FilesMatch "\.(ttf|otf|woff|woff2|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Manifesto & Feeds
  <FilesMatch "\.(webmanifest|json|xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Adicionar headers de segurança & performance
  Header set X-UA-Compatible "IE=edge"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Enable ETags para validação rápida
<IfModule mod_eTag.c>
  FileETag MTime Size
</IfModule>

# ============================================================
# REWRITE RULES
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Remove trailing slashes (optional)
  # RewriteCond %{REQUEST_FILENAME} !-d
  # RewriteRule ^(.+)/$ /$1 [L,R=301]
</IfModule>

# Fin
